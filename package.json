{
  "name": "slashcommands",
  "version": "1.0.1",
  "description": "A Notion-style / menu for Obsidian notes: headings, to-do, lists, toggle, quote, divider, callout, code, tables and today's date.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node test/run.mjs"
  },
  "keywords": ["obsidian", "slash", "notion", "slash-commands", "editor"],
  "author": "pizdec.tv",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.20.2",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  }
}
